# Keep this repository Flutter-only.
*
!/.gitignore
!/README.md
!/docs/
!/docs/**
!/flutter_app/
!/flutter_app/**

# Flutter generated files
flutter_app/.dart_tool/
flutter_app/.packages
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.metadata
flutter_app/android/.gradle/
flutter_app/ios/Pods/
# Added by code-review-graph
.code-review-graph/

# Firebase 설정 (키 포함 — 커밋 금지, 팀원 각자 단톡 공유본 사용)
flutter_app/android/app/google-services.json

# 로컬 환경값 (지도 API 키 포함 — 커밋 금지, .env.example만 공유)
flutter_app/.env.local
flutter_app/.env.*.local

# 로컬 실행용 임시 AppData (flutter 텔레메트리)
flutter_app/.tmp-appdata/
